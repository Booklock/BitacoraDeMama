# Copia este archivo a .env.local para desarrollo, y carga las mismas
# variables en Netlify (Site configuration → Environment variables).
# Las tres salen de Supabase → Project Settings → API. Ver docs/05-despliegue.md.

# URL del proyecto, del tipo https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave pública (anon / publishable). Va al navegador: es pública por diseño,
# y quien protege los datos es Row Level Security, no el secreto de esta llave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio (service_role). SECRETA: se salta RLS por completo.
# Sólo para tareas de servidor como sembrar el catálogo o refrescar tasas.
# Nunca la pongas en una variable NEXT_PUBLIC_, y nunca la subas al repo.
SUPABASE_SERVICE_ROLE_KEY=
